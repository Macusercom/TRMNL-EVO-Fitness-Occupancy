<div class="layout layout--col gap">
  {% if has_live == false %}
    {% render "evo_notice", glyph: "!", title: notice_title, sub: notice_sub %}
  {% else %}
    <div class="flex flex--col gap--xsmall stretch-x">
      <span class="label">{{ t_now }}</span>
      <span class="value value--xxxlarge value--tnums">{{ live_pct }}%</span>
      <span class="title title--small">{{ status }}</span>
      <span class="label label--small lg:label--large">{{ live_now }} / {{ live_cap }} {{ t_people }}</span>
      {% render "evo_meter", pct: bar_pct, width: 96 %}
    </div>
    <div class="flex flex--col gap--xsmall stretch-x">
      {% if today_ok %}
        <span class="title title--small">{{ t_today }}</span>
        {% render "evo_chart", intervals: today, t_now_short: t_now_short, track: 26, compact: true %}
        {% if best_name != "" %}
          <span class="label label--small lg:label--large mt--2">{{ t_best }}: {{ best_label }}</span>
        {% endif %}
        {% if tomorrow_ok %}<div class="hidden lg:portrait:visible w--full mt--4"><span class="title title--small">{{ t_tomorrow }} · {{ t_forecast }}</span>{% render "evo_chart", intervals: tomorrow, t_now_short: t_now_short, track: 14, compact: true %}</div>{% endif %}
      {% else %}
        <span class="label label--small">{{ t_no_history }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>

{% render "evo_title_bar", icon: title_bar_icon, title: gym_name, instance: updated %}
