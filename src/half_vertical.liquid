<div class="layout layout--col gap">
  {% if has_live == false %}
    {% render "evo_notice", glyph: "!", title: notice_title, sub: notice_sub %}
  {% else %}
    <div class="flex flex--col gap--xsmall stretch-x">
      <span class="label">{{ t_now }}</span>
      <span class="value value--xxxlarge value--tnums">{{ live_pct }}%</span>
      <span class="title title--small">{{ status }}</span>
      <div class="progress-bar stretch-x">
        <div class="content">
          <span class="label label--small">{{ live_now }} / {{ live_cap }} {{ t_people }}</span>
        </div>
        <div class="track">
          <div class="fill" style="width: {{ bar_pct }}%"></div>
        </div>
      </div>
    </div>
    <div class="flex flex--col gap--xsmall stretch-x">
      {% if today_ok %}
        <span class="title title--small">{{ t_today }}</span>
        {% render "evo_chart", intervals: today, t_now_short: t_now_short, height: 120, compact: true %}
        {% if best_name != "" %}
          <span class="label label--small mt--2">{{ t_best }}: {{ best_label }}</span>
        {% endif %}
      {% else %}
        <span class="label label--small">{{ t_no_history }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>

{% render "evo_title_bar", icon: title_bar_icon, title: gym_name, instance: updated %}
