{% comment %} ---------- live occupancy (IDX_0 = /current) ---------- {% endcomment %}
{% assign has_live = false %}
{% if IDX_0.current != nil %}{% assign has_live = true %}{% endif %}
{% assign live_now = IDX_0.current | default: 0 | plus: 0 %}
{% assign live_cap = IDX_0.max_capacity | default: 0 | plus: 0 %}
{% assign live_pct = IDX_0.percentageUsed | default: 0 | round %}
{% assign bar_pct = live_pct %}
{% if bar_pct > 100 %}{% assign bar_pct = 100 %}{% endif %}
{% assign gym_name = IDX_0.name | default: "EVO Fitness" | strip %}

{% assign status = t_s1 %}
{% if live_pct >= 85 %}{% assign status = t_s4 %}{% elsif live_pct >= 60 %}{% assign status = t_s3 %}{% elsif live_pct >= 35 %}{% assign status = t_s2 %}{% endif %}

{% assign notice_title = t_error %}
{% assign notice_sub = t_error_sub %}
{% if gym_id == "" %}{% assign notice_title = t_select %}{% assign notice_sub = t_select_sub %}{% endif %}

{% comment %} ---------- time slots (IDX_1 = today, IDX_2 = tomorrow) ----------
  Values above 250 % mean EVO's slot data is broken for this gym (all German
  gyms at the time of writing) - the charts are hidden then.
{% endcomment %}
{% assign today = IDX_1.intervals %}
{% assign today_ok = false %}
{% if today.size > 0 %}
  {% assign today_ok = true %}
  {% for iv in today %}{% if iv.percentageUsed > 250 %}{% assign today_ok = false %}{% endif %}{% endfor %}
{% endif %}

{% assign tomorrow = IDX_2.intervals %}
{% assign tomorrow_ok = false %}
{% if tomorrow.size > 0 %}
  {% assign tomorrow_ok = true %}
  {% for iv in tomorrow %}{% if iv.percentageUsed > 250 %}{% assign tomorrow_ok = false %}{% endif %}{% endfor %}
{% endif %}

{% comment %} quietest slot still ahead (a forecast of 0 means "unknown" at EVO) {% endcomment %}
{% assign best_pct = 999 %}
{% assign best_name = "" %}
{% assign best_is_tomorrow = false %}
{% assign peak_pct = -1 %}
{% assign peak_name = "" %}
{% if today_ok %}
  {% for iv in today %}
    {% assign p = iv.percentageUsed | round %}
    {% if iv.status == "future" and p > 0 and p < best_pct %}
      {% assign best_pct = p %}{% assign best_name = iv.name %}
    {% endif %}
    {% if iv.status != "current" and p > peak_pct %}
      {% assign peak_pct = p %}{% assign peak_name = iv.name %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if best_name == "" and tomorrow_ok %}
  {% for iv in tomorrow %}
    {% assign p = iv.percentageUsed | round %}
    {% if p > 0 and p < best_pct %}
      {% assign best_pct = p %}{% assign best_name = iv.name %}{% assign best_is_tomorrow = true %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign best_label = best_name | replace: "-", "–" | append: t_unit %}
{% if best_is_tomorrow %}{% assign best_label = t_tomorrow | append: " " | append: best_label %}{% endif %}
{% assign peak_label = peak_name | replace: "-", "–" | append: t_unit %}

{% assign updated = "now" | date: "%s" | plus: trmnl.user.utc_offset | date: "%H:%M" %}
{% assign t_instance = "EVO Fitness · " | append: t_updated | append: " " | append: updated %}

{% comment %} Bar chart of six time slots, built from framework utilities only.
  Heights use h--[Ncqh] (percent of the layout height), so the chart scales with
  the screen. `track` is the full bar height in cqh. Bars are relative indicators
  without numbers. The running slot is drawn as EVO's own page draws it: at
  EVO's figure for the slot so far, which is close to the live count and so
  usually lower than finished slots. Each slot sits in an outlined box whose
  full height is 100 %, or the busiest slot (then labelled) when a gym runs above 100 %. {% endcomment %}
{% template evo_chart %}
{% assign scale = 100 %}
{% for iv in intervals %}
  {% assign p = iv.percentageUsed | round %}
  {% if iv.status != "current" and p > scale %}{% assign scale = p %}{% endif %}
{% endfor %}
{% if scale > 100 %}<div class="w--full text--right"><span class="label label--small">{{ scale }}%</span></div>{% endif %}
<div class="grid grid--cols-6 gap--xsmall w--full">
  {% for iv in intervals %}
    {% assign bar = iv.percentageUsed | times: track | divided_by: scale | round %}
    {% if bar > track %}{% assign bar = track %}{% endif %}
    {% if bar < 1 %}{% assign bar = 1 %}{% endif %}
    {% assign rest = track | minus: bar %}
    {% comment %} Optional other sizes: track_p for small portrait screens (OG portrait),
      track_lg for large landscape screens (TRMNL X). Large portrait keeps the base size. {% endcomment %}
    {% assign rest_cls = "h--[" | append: rest | append: "cqh]" %}
    {% assign bar_cls = "h--[" | append: bar | append: "cqh]" %}
    {% if track_p %}
      {% assign bar_p = iv.percentageUsed | times: track_p | divided_by: scale | round %}
      {% if bar_p > track_p %}{% assign bar_p = track_p %}{% endif %}
      {% if bar_p < 1 %}{% assign bar_p = 1 %}{% endif %}
      {% assign rest_p = track_p | minus: bar_p %}
      {% assign rest_cls = rest_cls | append: " portrait:h--[" | append: rest_p | append: "cqh]" %}
      {% assign bar_cls = bar_cls | append: " portrait:h--[" | append: bar_p | append: "cqh]" %}
    {% endif %}
    {% if track_lg %}
      {% assign bar_lg = iv.percentageUsed | times: track_lg | divided_by: scale | round %}
      {% if bar_lg > track_lg %}{% assign bar_lg = track_lg %}{% endif %}
      {% if bar_lg < 1 %}{% assign bar_lg = 1 %}{% endif %}
      {% assign rest_lg = track_lg | minus: bar_lg %}
      {% assign rest_cls = rest_cls | append: " lg:h--[" | append: rest_lg | append: "cqh]" %}
      {% assign bar_cls = bar_cls | append: " lg:h--[" | append: bar_lg | append: "cqh]" %}
    {% endif %}
    {% if track_p or track_lg %}
      {% assign rest_cls = rest_cls | append: " lg:portrait:h--[" | append: rest | append: "cqh]" %}
      {% assign bar_cls = bar_cls | append: " lg:portrait:h--[" | append: bar | append: "cqh]" %}
    {% endif %}
    {% assign shade = "bg--black" %}
    {% if iv.status == "future" %}{% assign shade = "bg--gray-45" %}{% endif %}
    {% if iv.status == "current" %}{% assign shade = "bg--gray-25" %}{% endif %}
    <div>
      <div class="outline">
        <div class="{{ rest_cls }}"></div>
        <div class="w--full {{ bar_cls }} {{ shade }}"></div>
      </div>
      <div class="text--center">
        {% if iv.status == "current" %}
          <span class="label label--small label--inverted">{{ t_now_short }}</span>
        {% elsif compact %}
          <span class="label label--small">{{ iv.name | slice: 0, 2 }}{{ t_unit }}</span>
        {% else %}
          <span class="label label--small">{{ iv.name | replace: "-", "–" }}{{ t_unit }}</span>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
{% endtemplate %}

{% template evo_legend %}
<div class="flex flex--row flex--center-y gap--small">
  <div class="w--[12px] h--[12px] bg--black"></div><span class="label label--small">{{ t_actual }}</span>
  <div class="w--[12px] h--[12px] bg--gray-45"></div><span class="label label--small">{{ t_forecast }}</span>
</div>
{% endtemplate %}

{% comment %} Occupancy bar. `width` is the full bar width in cqw (percent of the layout width). {% endcomment %}
{% template evo_meter %}
{% assign fill = pct | times: width | divided_by: 100 | round %}
{% if fill < 1 %}{% assign fill = 1 %}{% endif %}
<div class="w--[{{ width }}cqw] bg--gray-65 rounded--small">
  <div class="w--[{{ fill }}cqw] h--[3cqh] bg--black rounded--small"></div>
</div>
{% endtemplate %}

{% template evo_notice %}
<div class="flex flex--col flex--center flex--center-x gap stretch-x">
  <span class="value value--xxlarge">{{ glyph }}</span>
  <span class="label label--large">{{ title }}</span>
  {% if sub %}<span class="label label--small">{{ sub }}</span>{% endif %}
</div>
{% endtemplate %}

{% template evo_title_bar %}
<div class="title_bar">
  <img class="image image-dither" src="{{ icon }}">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ instance }}</span>
</div>
{% endtemplate %}
